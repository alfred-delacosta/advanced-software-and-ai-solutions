# Public site contact address (mailto fallback always uses this via data/contact.ts).
CONTACT_TO_EMAIL=contact@advancedsoftwareandaisolutions.com

# Optional: Formspree form endpoint for static hosting contact submissions.
# Example: https://formspree.io/f/xxxxxxxx
# Create a form at https://formspree.io, then set this at build time as NEXT_PUBLIC_FORMSPREE_ENDPOINT.
# If unset, the contact form opens a pre-filled mailto: instead (Hostinger-safe default).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Waitlist CTAs use mailto (no Formspree endpoint required).
