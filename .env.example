# Public base URL for the Hostinger Node mail API (no trailing slash).
# Example: https://mail.advancedsoftwareandaisolutions.com
# When set, contact + waitlist forms POST JSON and wait for HTTP 200 (Resend).
# Never put RESEND_API_KEY or other secrets in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_MAIL_API_URL=

# Optional legacy Formspree endpoint (used only if MAIL_API_URL is unset).
# Example: https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Public site contact address (mailto fallback / display).
CONTACT_TO_EMAIL=contact@advancedsoftwareandaisolutions.com
